# Automation Server — Environment Configuration
# Copy to .env and customize for your environment

# ─── Common ────────────────────────────────────────
TZ=Europe/Copenhagen

# ─── Database ──────────────────────────────────────
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_password
POSTGRES_DB=ats

# ─── Security ──────────────────────────────────────
# Encrypts credential usernames and passwords at rest in the database.
# Any non-empty string works as the key; use a long random value.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# or:
#   openssl rand -base64 32
#
# Optional. Leave unset to store credentials as plaintext (the server
# warns at startup and the UI flags them as "unencrypted"). Credentials
# that already exist when a key is set stay plaintext until they are
# written again — use "Encrypt all now" on the Credentials page, or
# POST /credentials/reencrypt, to rewrite them in one pass.
#
# Only the username and password are encrypted; the credential's Data
# field is stored as-is, so do not put secrets there.
#
# IMPORTANT: Back up this key. If it is lost, encrypted credentials
# cannot be recovered and must be re-entered. Changing the key has the
# same effect. Do not commit the .env file to version control.
#ENCRYPTION_KEY=

# Comma-separated list of origins the API accepts cross-origin browser
# requests from. Leave unset for same-origin only, which is correct for
# this compose setup — the frontend and API share the nginx proxy in
# front of them, so the browser never makes a cross-origin request.
# Only needed if you serve the frontend from a different origin (e.g. a
# separately hosted SPA). Set to "*" to allow any origin.
#CORS_ALLOW_ORIGINS=

# ─── Workers ──────────────────────────────────────
ATS_TOKEN=                          # Leave blank for development
ATS_URL=http://api:8000             # Internal Docker network URL
# Extra capabilities on top of the built-in ones (python, playwright and
# the OS name). Leave blank unless you have customized your workers.
ATS_CAPABILITIES=

# ─── Deployment ───────────────────────────────────
# Standalone (ATS owns port 80):
#   HTTP_PORT=80                    (default)
#
# Behind reverse proxy (Caddy, Traefik, etc.):
#   HTTP_PORT=8080                  (or any free port)
#   Point your proxy to http://localhost:8080
